\f0\fs24 \cf0 --create domain name as data_type constraint\
\
create domain addr varchar(100) not null;\
\
create table locations(\
	address addr\
);\
\
insert into locations(address) values \
('London')\
\
select * from locations;\
\
--create positive numeric data_type\
\
create domain positive_numeric INT NOT NULL check (value > 0)\
\
create table sample(\
	sample_id serial primary key,\
	value_num positive_numeric\
);\
\
insert into sample(value_num) values (-10)\
insert into sample(value_num) values (10)\
\
select * from sample;\
\
-- domain to check valid us postal code\
create domain us_postal_code as text\
check(\
	value ~'^\\d\{5\}$'\
	or value ~'^\\D\{5\}-\\d\{4\}$'\
)\
\
create table addresses(\
	address_id serial primary key,\
	postal_code us_postal_code\
);\
\
\
insert into addresses(postal_code) values ('20000')\
insert into addresses values ('10000-10')\
\
select * from addresses;\
\
--proper email domain to check email\
\
create domain proper_email varchar(150)\
check (value \
	~'^[\\w-\\.]+@([\\w-]+\\.)+[\\w-]\{2,4\}$'\
	)\
\
create table client_names(\
	client_name_id serial primary key,\
	email proper_email\
)\
\
drop table client_names;\
drop domain proper_email;\
\
select * from client_names;\
\
insert into client_names(email) \
	values ('asd123@asd.com')\
\
--create an enumeration type (enum or set of values) domain\
create domain valid_colour varchar(10)\
check (value in ('red', 'green', 'blue'))\
\
create table colours(\
	color valid_colour\
)\
\
insert into colours(color) values ('blue')\
\
select * from colours;\
\
