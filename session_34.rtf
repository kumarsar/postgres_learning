-- on conflict do nothing\
INSERT INTO t_tags(tag)\
VALUES ('pen')\
ON CONFLICT (tag)\
DO NOTHING;\
\
-- on conflict update\
INSERT INTO t_tags(tag)\
VALUES ('pen')\
ON CONFLICT (tag)\
DO \
	UPDATE SET \
		tag = EXCLUDED.tag,\
		update_date = NOW()\
		RETURNING *;\
		\
-- on conflict update and append 1 to tag column\
INSERT INTO t_tags(tag)\
VALUES ('pen')\
ON CONFLICT (tag)\
DO \
	UPDATE SET \
		tag = EXCLUDED.tag || '1',\
		update_date = NOW()\
		RETURNING *;\
