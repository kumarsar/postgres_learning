\f0\fs24 \cf0 /*\
	Table Inheritance \
*/\
\
-- let's create our table\
\
create table master(\
	pk serial primary key,\
	tag text, \
	parent integer\
)\
\
create table master_child() inherits (master);\
\
alter table master_child \
add constraint master_pk primary key (pk);\
\
-- lets view the records\
\
select * from master\
select * from master_child\
\
-- insert some data\
\
insert into master(pk, tag, parent)\
values\
(1, 'Pen', 0)\
\
insert into master_child(pk, tag, parent)\
values\
(2, 'Pencil', 0)\
\
--check records\
select * from master\
select * from master_child\
\
-- FOR only \
select * from only master\
select * from only master_child\
\
-- effects of update operations\
update master\
set tag = 'monitor'\
where pk = 2\
\
-- delete effects\
\
delete from master where pk = 2\
\
-- dropping master table\
drop table master -- error  (table master_child depends on table mastercannot \
-- drop table master because other objects depend on it )\
\
drop table master cascade\
\
-- In postgres 12, inheritance propagates the operations performed on the parent table to the child tables\
\
}