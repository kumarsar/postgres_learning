--HAVING CLAUSE\
-- to specify a special condition for a group or an aggregate\
-- often used with group by clause to to filter rows based on filter conditions\
-- cannot use column aliases in having clause, \
-- as having clause is evaluated before the select clause\
-- It calculates on aggregate function and not actual select columns\
\
--list movie languages where sum total length of movies is greater than 200\
select * from movies\
\
select\
	movie_lang,\
	sum(movie_length)\
from\
	movies\
group by\
	movie_lang\
having \
	sum(movie_length) > 200\
\
select\
	movie_lang,\
	sum(movie_length)\
from\
	movies\
group by\
	movie_lang\
having \
	age_certificate > '15'\
	\
-- HAVING without using group by\
\
select\
	sum(movie_length)\
from\
	movies\
having \
	sum(movie_length) > 200\
\
--list directors where their sum total movie length > 200\
\
select \
	director_id,\
	sum(movie_length)\
from \
	movies\
group by\
	director_id\
having \
	sum(movie_length) > 200\
order by\
	sum(movie_length) desc\
	\
-- can we use column aliases with having clause ? : NO\
\
select \
	director_id,\
	sum(movie_length) as sum_movie_length\
from \
	movies\
group by\
	director_id\
having \
	sum(movie_length) > 200\
order by\
	sum(movie_length) desc\
\
-- order of execution in having clause\
-- Postgres evaluates having clause after from, where, group by\
-- and before\
-- select , distinct, order by and limit clause\
\
-- HAVING vs WHERE\
-- Having works on result group\
-- where works on select columns and not on result group\
\
-- lets try using where\
select\
	movie_lang,\
	sum(movie_length)\
from\
	movies\
where\
	movie_length > 100\
group by\
	movie_lang\
order by\
	2 desc\
	\
-- Handling NULL values with group by\
\
create table employee_test (\
	employee_id serial primary key,\
	emp_name varchar(20),\
	department varchar(20),\
	salary INT\
);\
\
select * from employee_test\
\
insert into \
	employee_test(\
		emp_name, department, salary\
	)\
values \
	('john', null, 2600),\
	('sam', null, 2300),\
	('roy', 'finance', 2900),\
	('bruce', 'finanace', 3600);\
	\
select * from employee_test\
order by department\
\
-- how many employee are there in each group\
select\
	department,\
	count(salary) as total_employees\
from\
	employee_test\
group by\
	department\
order by \
	department\
	\
-- Lets handle the NULL values\
-- COALESCE(source, '')\
-- COALESCE(department, 'NO DEPARTMENT')\
\
select\
	COALESCE(department, 'NO DEPARTMENT') as department,\
	count(salary) as total_employees\
from\
	employee_test\
group by\
	department\
order by \
	department\
	}