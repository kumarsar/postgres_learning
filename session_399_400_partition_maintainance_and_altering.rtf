-- detach a partition\
\
alter table table_name detach partition partition_name\
\
alter table employee_list\
detach partition employee_list_sp\
\
select * From employee_list\
\
-- altering bounds of partition\
\
create table t1(\
	a int,\
	b int\
) partition by range(a)\
0-100\
100-200\
\
create table tlp1 partition of t1 \
for values from (0) to (100)\
\
create table tlp2 partition of t1 \
for values from (200) to (300)\
\
insert into t1(a, b)\
values (1,1)\
\
select * From t1\
select * From tlp1\
select * From tlp2\
\
insert into t1(a, b)\
values (150,150)\
\
-- detach\
-- alter\
-- attach\
\
rollback\
	\
begin transaction\
	alter table t1 detach partition tlp1\
	alter table t1 attach partition tlp1 for values from (0) to (200)\
end transaction\
\
