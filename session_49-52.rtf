\f0\fs24 \cf0 --WHERE should only be used after 'FROM' and before 'ORDER BY'\
\
-- AND is processed FIRST and the OR is processed SECOND\
\
-- SQL processed AND like MULTIPLICATION and OR like ADDITION unless\
-- we use paranthesis\
\
select \
	first_name,\
	last_name as lastname\
from actors;\
\
-- If you use column aliases in select clause, then you cannot use them in where clause.\
-- but for sub-queries, you can use that\
select \
	first_name,\
	last_name as lastname\
from actors\
where lastname = 'Allen';\
\
--order of execution of\
--FROM\
--WHERE\
--SELECT\
--ORDER BY\
\
-- FROM >> WHERE >> SELECT >> ORDERBY\
\
SELECT \
	*\
FROM movies\
WHERE \
	movie_lang = 'English'\
ORDER BY\
	movie_id;\
