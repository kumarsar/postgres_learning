5	1	\{4,5,6\}	\{4,5,6\}	\{1,1,2\}	\{0,0,1,1,1,2,2,2\}\
6	2	\{5,6,7\}	\{5,6,7\}	\{1,2,2\}	\{1,1,1,2,2,2,3,3\}\
7	2	\{6,7,8\}	\{6,7,8\}	\{2,2,2\}	\{1,1,1,2,2,2,3,3\}\
8	2	\{7,8,9\}	\{7,8,9\}	\{2,2,3\}	\{1,1,1,2,2,2,3,3\}\
