-- using with clause for order by values\
\
-- 1. Lets create a sample table\
\
create table t_order(\
	id serial primary key,\
	item varchar(100)\
)\
\
-- 2. insert values\
insert into \
	t_order (item)\
values \
	('Pen'),\
	('Paper'),\
	('Pencil'),\
	('Book'),\
	('Printer')\
\
-- 3. verify the data\
	\
select * from t_order\
order by item desc\
\
-- 4. what if you want the order to come in follwoing way\
-- Book, Pencil, Pen, Printer, Paper\
\
with t_data (list_order, item) as\
(\
	values\
	(1, 'Book'),\
	(2, 'Pencil'),\
	(3, 'Pen'),\
	(4, 'Printer'),\
	(5, 'Paper')\
)\
select *\
from t_order\
join t_data on t_data.item = t_order.item\
\
-- now apply order by with list_order\
\
with t_data (list_order, item) as\
(\
	values\
	(1, 'Book'),\
	(2, 'Pencil'),\
	(3, 'Pen'),\
	(4, 'Printer'),\
	(5, 'Paper')\
)\
select *\
from t_order\
join t_data on t_data.item = t_order.item\
order by list_order\
\
