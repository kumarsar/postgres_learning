-- rank and global rank\
\
select \
	first_name,\
	salary,\
	department_id,\
	rank() over w_department,\
	rank() over w_all_departments\
from \
	employees\
window \
	w_department as (partition by department_id order by salary),\
	w_all_departments as (order by salary desc)\
order by\
	department_id, salary\
\
-- partition by departments\
\
select \
	first_name,\
	salary,\
	department_id,\
	round(avg(salary) over (partition by department_id), 2),\
	round(salary - avg(salary) over (partition by department_id), 2) as difference\
from\
	employees\
order by\
	department_id, salary desc\
\
