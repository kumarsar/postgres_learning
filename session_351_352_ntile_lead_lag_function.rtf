-- NTILE function : it groups data into sets\
	\
select \
	year, \
	exports,\
	ntile(4) over (order by exports)\
from \
	trades\
where \
	year > 2000 and\
	country = 'USA'\
\
select \
	country,\
	year, \
	exports,\
	ntile(4) over (partition by country order by exports) as r\
from \
	trades\
where \
	year > 2000 and\
	country in ('USA', 'Belgium', 'France')\
\
select * \
from (\
	select \
	country,\
	year, \
	exports,\
	ntile(5) over (partition by year order by exports) as r\
from \
	trades\
where \
	year > 2000 and\
	country in ('USA', 'Belgium', 'France')\
) as t\
where r = 2\
\
\
/*\
LEAD and LAG function\
\
1. Lead and lag allows tyou to move lines within the result set\
2. Very useful to compare data of current row with any other rows(going backward LAG forward LEAD)\
3. LEAD function access a row that follows the current row , at a specific physical offset\
	-	AFTER THE CURRENT ROW\
		LEAD (expression, offset [, default_value])\
4. LEAD function access a row which comes before the current row , at a specific physical offset\
	-	BEFORE THE CURRENT ROW\
		LAG (expression, offset [, default_value])\
*/\
\
-- lets calculate the difference of exports from one year to another year for Belgium\
\
select \
	year,\
	exports,\
	LEAD(exports, 1) over (order by year desc)\
from \
	trades\
where\
	country = 'Belgium'\
\
select \
	year,\
	exports,\
	LAG(exports, 1) over (order by year)\
from \
	trades\
where\
	country = 'Belgium'\
\
select \
	country,\
	year,\
	exports,\
	exports - LAG(exports, 1) over (partition by country order by year) \
from \
	trades\
where\
	country in ('Belgium', 'USA')}