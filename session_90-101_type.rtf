\f0\fs24 \cf0 --composite data types\
\
--list of field names with corressponding data types\
-- used in a table as column\
-- used in a procedure / function\
-- can return multiple values\
\
--create a address composite type\
create type address as (\
	city varchar(50),\
	country varchar(20)\
);\
\
create table companies (\
	comp_id serial primary key,\
	address address\
);\
\
insert into companies(address) values (row('bangalore', 'India'))\
insert into companies(address) values (row('delhi', 'India'))\
	\
select * from companies;\
\
select address from companies;\
\
select (address).city from companies;\
\
--when we are dealing with multiple companies\
\
select (companies.address).city from companies;\
\
select (companies.address).city from companies where (companies.address).city = 'delhi';\
\
--create a currency  ENUM data type \
\
create type currency as ENUM('INR', 'USD', 'GBP')\
\
select 'INR'::currency\
\
alter type currency add value 'EUR' after 'USD'\
\
create table stocks(\
	stock_id serial primary key,\
	stock_currecy currency\
)\
\
insert into stocks(stock_currecy) values ('USD')\
\
select * from stocks\
\
--drop type name\
\
--create and alter type\
create type myaddress as (\
	city varchar(50),\
	country varchar(20)\
)\
\
alter type myaddress rename to my_address\
\
--alter type my_address owner to owner_name\
