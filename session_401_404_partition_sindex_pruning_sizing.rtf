\f0\fs24 \cf0 --partition indexing\
\
SELECT id, birth_date, country_code\
	FROM public.employee_list;\
\
create unique index idx_uniq_employee_list_id\
on employee_list (id)\
\
create unique index idx_uniq_employee_list_id_country_code\
on employee_list (id, country_code)\
\
-- switching partition pruning on/off\
-- view current value\
show enable_partition_pruning\
\
-- lets visualize in pgadmin \
select * from employee_list\
select * from employee_list where country_code = 'US'\
\
-- when pruning is on, identify whcih partition the query should scan\
set enable_partition_pruning = off\
\
select * from employee_list where country_code = 'US'\
\
set enable_partition_pruning = on\
\
--sizing the partition\
\
-- 1. Get high/low numbers of your key field\
\
select \
	min(order_date),\
	max(order_date)\
from orders\
\
-- 2. Get unique values of key field\
\
select \
	distinct(order_date)\
from orders\
\
select \
	distinct(country_code)\
from orders\
\
-- 3. get total count of your key field\
--  this will help in evenly partition\
\
select\
	order_date,\
	count(*)\
from orders\
group by order_date\
\
select\
	country_code,\
	count(*)\
from orders\
group by country_code\
\
