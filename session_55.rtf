\f0\fs24 \cf0 --using fetch \
\
-- fetch clause to retrieve a portion of rows returned by a query\
-- introduced in sql 2008\
-- functionally equivalent to limit clause\
\
/*\
	OFFSET start \{row | rows\}\
	FETCH \{ FIRST | NEXT \} [row count] \{row | rows\} ONLY\
*/\
\
-- OFFSET start is an integer , that must be positive or zero. default = 0 \
-- in case start > number of rows. no rows will be returned\
\
--get first row of movie table\
\
SELECT \
	*\
FROM movies\
FETCH FIRST 5 ROW ONLY;\
\
--get first 5 movies by movie lenght\
\
SELECT \
	*\
FROM movies\
ORDER BY \
	movie_length DESC\
FETCH FIRST 5 ROW ONLY;\
\
--get first 5 movies by movie length starting 5th record\
\
SELECT \
	*\
FROM movies\
ORDER BY \
	movie_length DESC\
FETCH FIRST 5 ROW ONLY\
OFFSET 5;}