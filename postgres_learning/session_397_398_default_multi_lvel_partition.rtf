-- what happens when you try to insert  a record that can't fit into any partition ?\
\
insert into employee_list(id, birth_date, country_code)\
values \
(10, '2001-01-01', 'JP')\
\
create table partition_table_name partition of parent_table_name default;\
\
create table employee_list_default partition of employee_list default\
\
select * from employee_list\
\
-- sub partitioning \
\
/*\
\
1. A single partition can also be a partitioned table\
	partition table\
		partition 1\
			partition 1.1\
			partition 1.2\
		partition 2\
			partition 2.1\
			partition 2\
	specially on ranges, it is easy to create a large number of subpartitions , some \
	containing little or no data\
\
	this can add many entries to system tables, which increases the time and memory required to optimize \
	and execute queries\
\
2. sub partition naming convention plays a major role here, so plan the naming conventions\
\
*/\
\
CREATE table employees_master (\
	id bigserial,\
	birth_date date not null,\
	country_code varchar(2) not null\
) partition by list (country_code);\
\
\
-- partition and sub partition\
\
CREATE table employees_master_us partition of employees_master \
for values in ('US')\
\
CREATE table employees_master_eu \
partition of employees_master \
for values in ('UK','DE','IT','FR','ES')\
partition by hash (id);\
\
CREATE table employees_master_eu_1 partition of employees_master_eu \
for values with (modulus 3, remainder 0)\
\
CREATE table employees_master_eu_2 partition of employees_master_eu \
for values with (modulus 3, remainder 1)\
	\
CREATE table employees_master_eu_3 partition of employees_master_eu \
for values with (modulus 3, remainder 2)\
\
insert into employees_master \
	(id, birth_date,country_code)\
values \
	(1, '2000-01-01', 'US'),\
	(2, '2000-01-02', 'US'),\
	(3, '2000-12-31', 'UK'),\
	(4, '2001-01-01', 'DE')\
\
update employees_master\
	set id = 4 \
	where country_code = 'DE'\
\
select * from employees_master\
select * from employees_master_us\
select * from only employees_master_eu\
select * from employees_master_eu_1\
select * from employees_master_eu_2\
\
\
\
