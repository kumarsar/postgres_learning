\f0\fs24 \cf0 -- understanding query cost model\
\
create table t_big(id serial, name text);\
\
insert into \
	t_big(name)\
select 'Adam' from generate_series(1, 2000000);\
\
select count(*) from t_big;\
\
select * from t_big limit 10;\
\
insert into \
	t_big(name)\
select 'Linda' from generate_series(1, 2000000);\
\
explain select * from t_big where id = 12345\
\
show max_parallel_workers_per_gather\
set max_parallel_workers_per_gather to 0\
\
explain select * from t_big where id = 12345\
\
select pg_relation_size('t_big') -- 177127424 : bytes\
select pg_relation_size('t_big')/8192  -- 21622 blocks : block of 8192 each\
\
show seq_page_cost; -- 1 : pg , for each block, has to read sequentially \
\
-- above fetched rows need to be fed into CPU as well\
\
show cpu_tuple_cost;  -- 0.01\
\
show cpu_operator_cost;  -- 0.0025\
\
-- Cost formula : \
	pg_relation_size * seq_page_cost \
	+ total_num_of_table_records * cpu_tuple_cost \
	+ total_num_of_table_records * cpu_operator_cost\
\
select \
		21622 * 1\
		+ 4000000 * 0.01\
		+ 4000000 * 0.0025 -- which is equivalent to 71622\
\
set max_parallel_workers_per_gather to 2 -- set back to original value of 2\
}