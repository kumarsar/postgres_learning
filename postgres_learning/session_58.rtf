--LIKE\
--ILIKE\
--search for patterns in strings by using two special characters\
-- % -> matches any sequence of zero or more characters\
-- _ -> matches any single character\
\
--full character search \
SELECT 'hello' LIKE 'hello';\
\
--partial matching using '%'\
SELECT 'hello' LIKE 'h%'\
SELECT 'hello' LIKE '%ll%'\
\
--single pattern matching using '_'\
SELECT 'hello' LIKE 'hell_'\
\
--get all actors name starting with A\
SELECT\
	*\
FROM actors\
WHERE\
	first_name LIKE 'A%'\
ORDER BY first_name;\
\
--get all actors with first name with 5 characters only\
SELECT\
	*\
FROM actors\
WHERE\
	first_name LIKE '_____'\
ORDER BY first_name;\
\
--get all actors with first name containing Tim\
SELECT\
	*\
FROM actors\
WHERE\
	first_name LIKE '%Tim%'\
ORDER BY first_name;\
\
--get all actors with first name containing Tim\
SELECT\
	*\
FROM actors\
WHERE\
	first_name ILIKE '%tim%'\
ORDER BY first_name;\
\
--get all actors with first name containing tim (case-insensitive)\
SELECT\
	*\
FROM actors\
WHERE\
	first_name ILIKE '%tim%'\
ORDER BY first_name;}