\f0\fs24 \cf0 /*\
\
ROW_NUMBER() over\
(\
	partition by col1, col2\
	order by col3, col4\
)\
\
-- partition by clause is optional\
\
-- if partition by is not provided, then row_number() function will treat whole window as a single\
	partition or 1 partition\
*/\
\
-- select name, salalry , departmnet from employess , then use rown_number to order by salary\
\
select \
	e.first_name,\
	e.last_name,\
	e.salary,\
	\
	d.department_name,\
\
	row_number() over (order by salary)\
from employees e\
inner join departments d on e.department_id = d.department_id\
\
\
-- select name, salalry , departmnet from employess , then use rown_number to order by salary,\
-- partition by department name\
\
select \
	e.first_name,\
	e.last_name,\
	e.salary,\
	\
	d.department_name,\
\
	row_number() over (\
		partition by d.department_name \
		order by e.salary\
	)\
from employees e\
inner join departments d on e.department_id = d.department_id\
\
-- nth record\
-- select name, salalry , departmnet from employess for 2nd highest paid employee department wise\
\
select * from \
	(\
		select \
			e.first_name,\
			e.last_name,\
			e.salary,\
			\
			d.department_name,\
		\
			row_number() over (\
				partition by d.department_name \
				order by e.salary\
			) as r\
		from employees e\
		inner join departments d on e.department_id = d.department_id\
	) as t\
where r = 2\
\
-- use distinct with row_number()\
\
select \
	distinct(salary),\
	row_number() over (order by salary)\
from\
	employees\
order by \
	salary\
\
-- but why we have duplicates even though we applied distinct\
-- row_number() operates on the result set BEFORE the DISTINCT is applied\
-- solution -> use subquery\
\
select \
	salary,\
	row_number() over (order by salary)\
from\
	(\
		select distinct salary\
		from employees\
	) as t\
order by salary desc\
\
-- ROW number for PAGINATION techniques\
\
-- select name, salalry , departmnet from employess , then use rown_number to order by salary,\
-- partition by department name\
\
select * from\
	(\
		select \
			e.first_name,\
			e.last_name,\
			e.salary,\
			\
			d.department_name,\
		\
			row_number() over (\
				partition by d.department_name \
				order by e.salary\
			)	\
		from employees e\
		inner join departments d on e.department_id = d.department_id\
	) as t\
where row_number between 6 and 10\
\
-- list all salaries from row 6 and 10 : we can use row_number() for pagination too\
select * from\
	(\
		select \
			e.salary,\
			row_number() over \
			(\
				order by e.salary desc\
			)\
		from \
			employees e\
		\
	) as t\
where\
	row_number between 6 and 10 \
\
select salary from employees\
order by salary desc\
\
}