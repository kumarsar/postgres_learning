-- Expression index\
/*1. An index based on an expression , e.g.\
   UPPER (col_name)\
   COS (col_name)\
\
	2. Postgres will consider using that index when the expression that defines the index appears in\
	-	where clause\
	-	in order by clause of select\
\
	3. very expensive indexes\
	-	pg has to evaluate the expression for each row when it is inserted or update\
	-	and use the result for indexing\
*/\
\
create table t_dates as \
select d, repeat(md5(d::text), 10) as padding\
	from generate_series(timestamp '1800-01-01',\
						 timestamp '2100-01-01',\
						interval '1 day') s(d);\
\
vacuum analyze t_dates\
\
select count(*) from t_dates\
select * from t_dates limit 10\
\
explain analyze select * from t_dates where d between '2001-01-01' and '2001-01-31'\
-- without index : 26.8\
\
create index idx_t_dates_d on t_dates(d)\
explain analyze select * from t_dates where d between '2001-01-01' and '2001-01-31'\
-- with index scan : 0.078 ms\
ANALYZE t_dates\
\
\
explain analyze select * from t_dates where extract(day from d) = 1\
-- above analysis is done using sequential scan despite having index on column, but not on expression\
-- execution time : 34.171 ms\
\
create index idx_expr_t_dates on t_dates (extract (day from d))\
analyze t_dates\
\
explain analyze select * from t_dates where extract(day from d) = 1\
--now, it uses, bitmap heap scan\
-- execution time : 56.794 ms, ideally is should be less\
}