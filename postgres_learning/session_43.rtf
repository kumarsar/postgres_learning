\f0\fs24 \cf0 --using order by with null values\
\
-- when you sort rows that contains NULL, you can specify order of null with non-null values\
-- by using NULLS FIRST or NULLS LAST option of the order by clause\
\
CREATE TABLE demo_sorting(\
	num INT\
);\
\
INSERT INTO demo_sorting(num)\
VALUES \
(1),\
(2),\
(3),\
(NULL);\
\
SELECT \
	* \
FROM demo_sorting;\
\
SELECT \
	* \
FROM demo_sorting\
ORDER BY\
	num DESC;\
	\
--NULLS LAST\
\
SELECT \
	* \
FROM demo_sorting\
ORDER BY\
	num NULLS LAST;\
	\
--NULLS FIRST\
\
SELECT \
	* \
FROM demo_sorting\
ORDER BY\
	num NULLS FIRST;\
	\
-- \
\
--NULLS LAST as well as DESC : NULL LAST has more priority that DESC\
\
SELECT \
	* \
FROM demo_sorting\
ORDER BY\
	num DESC NULLS LAST;\
	\
-- drop table\
\
DROP TABLE demo_sorting;\
