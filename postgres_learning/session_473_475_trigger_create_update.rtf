\
-- players table\
-- we want to log all data when name of a player gets changed or updated\
\
-- Lets create players table\
\
create table players (\
	player_id serial primary key,\
	name varchar(200)\
)\
\
-- lets create players_audit table to store all the logs\
\
create table players_audit (\
	player_audit_id serial primary key,\
	player_id int not null,\
	name varchar(100) not null,\
	edit_date timestamp not null\
)\
\
-- we first create a table and then bind that function to our trigger\
-- lets create a function\
\
create or replace function fn_players_name_changes_log()\
returns trigger\
language plpgsql\
as\
$$\
BEGIN\
\
	--compare the new vs old value\
\
	IF NEW.name <> OLD.name THEN\
		insert into players_audit(\
			player_id,\
			name,\
			edit_date\
		)\
		values (\
			OLD.player_id,\
			OLD.name,\
			NOW()\
		);\
	END IF;\
\
	RETURN NEW;\
END;\
$$\
\
-- Bind our newly created function to our table 'players' via CREATE TRIGGER statement\
\
create trigger trg_players_name_changes\
	before update \
	on players\
	for each row\
	execute procedure fn_players_name_changes_log()\
\
--lets insert some data\
Insert into players(name)\
values \
	('ADAM'),\
	('LINDA')\
\
select * from players\
\
-- lets update some data\
\
UPDATE players\
set name = 'LINDA3'\
where player_id = 2\
\
select * from players_audit\
}