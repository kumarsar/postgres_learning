\f0\fs24 \cf0 -- 1. lets create our test table in which we will be calculating the subtotals\
\
create table courses(\
	course_id serial primary key,\
	course_name varchar(100) not null,\
	course_level varchar(100) not null,\
	sold_units int not null\
);\
\
--2. browse data \
select * from courses;\
\
-- 3. insert\
\
insert into \
	courses (course_name, course_level, sold_units)\
values \
	('Machine learning with python', 'premium', 100),\
	('Data science bootcamp', 'premium', 50),\
	('introduction to python', 'basic', 200),\
	('Understanding MongoDB', 'premium', 100),\
	('Algorithm design with python', 'premium', 200)\
\
select * from courses\
order by course_level, sold_units;\
\
-- 4. Lets organize some data\
\
select \
	course_level,\
	course_name,\
	sold_units\
from \
	courses\
\
-- 5. lets find total unit sold by each course level\
\
select \
	course_level,\
	sum(sold_units) as total_sold\
from \
	courses\
group by \
	course_level\
\
-- basic : 200\
-- premium : 450\
\
-- 6. lets organise a bit more using order by\
\
select \
	course_level,\
	course_name,\
	sum(sold_units) as total_sold\
from \
	courses\
group by \
	course_level,\
	course_name\
order by \
	course_level,\
	course_name\
\
-- 7. lets use rollup\
\
select \
	course_level,\
	course_name,\
	sum(sold_units) as total_sold\
from \
	courses\
group by \
	rollup(course_level,course_name)\
order by \
	course_level,\
	course_name\
\
-- 8. we can even do a partial rollup\
\
select \
	course_level,\
	course_name,\
	sum(sold_units) as total_sold\
from \
	courses\
group by \
	course_level,\
	rollup(course_name)\
order by \
	course_level,\
	course_name\
\
